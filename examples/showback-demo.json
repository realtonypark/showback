{
  "version": 1,
  "title": "Showback demonstrates its own Settings",
  "app": "Showback",
  "window": {
    "title": "Showback Settings"
  },
  "scenes": [
    {
      "say": "This is Showback. I will check that the English speech model is installed locally.",
      "actions": [
        {
          "point": {
            "role": "statictext",
            "text": "Pocket TTS English 18M"
          }
        }
      ],
      "expect": {
        "role": "statictext",
        "text": "Pocket TTS English 18M"
      }
    },
    {
      "say": "The English speech model is installed."
    },
    {
      "say": "This picker controls the voice used for future demonstrations. I can inspect it without changing your saved choice.",
      "actions": [
        {
          "point": {
            "role": "combobox",
            "name": "Voice"
          }
        }
      ],
      "expect": {
        "role": "combobox",
        "name": "Voice"
      }
    },
    {
      "say": "The voice picker is available."
    }
  ]
}
